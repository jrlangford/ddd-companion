{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/ddd-implement-manifest.schema.json",
  "title": "DDD Implementation Manifest",
  "description": "Tracks progress of DDD implementation from bounded context definitions",
  "type": "object",
  "required": ["version", "project", "source", "currentPhase", "contexts"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Manifest schema version. Increment on breaking schema changes; when loading a manifest with a different version, warn the user and attempt best-effort field mapping.",
      "const": "1.0"
    },
    "project": {
      "type": "object",
      "description": "Project configuration",
      "required": ["name", "module", "language", "generator"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name (used for directory and display)"
        },
        "module": {
          "type": "string",
          "description": "Go module path (e.g., github.com/org/project)"
        },
        "language": {
          "type": "string",
          "description": "Target implementation language",
          "enum": ["go"]
        },
        "generator": {
          "type": "string",
          "description": "Generator to use for code generation",
          "enum": ["go-hex"]
        },
        "outputDir": {
          "type": "string",
          "description": "Output directory for generated code (defaults to .)"
        }
      }
    },
    "source": {
      "type": "object",
      "description": "Source configuration for BCR workspace",
      "required": ["bcrWorkspace"],
      "properties": {
        "bcrWorkspace": {
          "type": "string",
          "description": "Path to BCR workspace directory containing bounded context definitions"
        }
      }
    },
    "currentPhase": {
      "type": "string",
      "description": "Current position in the overall workflow",
      "enum": ["support", "contexts", "drivingAdapters", "apiContracts", "mainWiring", "validation", "complete"]
    },
    "currentContext": {
      "type": ["string", "null"],
      "description": "Which context is currently being processed (null if between contexts)"
    },
    "infrastructure": {
      "type": "object",
      "description": "Shared infrastructure status",
      "properties": {
        "support": {
          "type": "object",
          "description": "Support packages (auth, config, validation, etc.)",
          "properties": {
            "status": { "$ref": "#/$defs/phaseStatus" },
            "files": { "$ref": "#/$defs/fileList" }
          }
        },
        "eventBus": {
          "type": "object",
          "description": "Event bus implementation",
          "properties": {
            "status": { "$ref": "#/$defs/phaseStatus" },
            "files": { "$ref": "#/$defs/fileList" }
          }
        },
        "mainWiring": {
          "type": "object",
          "description": "Main.go dependency wiring",
          "properties": {
            "status": { "$ref": "#/$defs/phaseStatus" },
            "files": { "$ref": "#/$defs/fileList" }
          }
        }
      }
    },
    "apiContracts": {
      "type": "object",
      "description": "API contract generation configuration",
      "properties": {
        "status": {
          "type": "string",
          "description": "Overall contract generation status",
          "enum": ["pending", "in_progress", "complete", "error"],
          "default": "pending"
        },
        "files": { "$ref": "#/$defs/fileList" },
        "format": {
          "type": "string",
          "description": "Contract specification format",
          "enum": ["typespec", "openapi"],
          "default": "typespec"
        },
        "outputDir": {
          "type": "string",
          "description": "Output directory for contracts (defaults to ./api)"
        },
        "compilationError": {
          "type": ["string", "null"],
          "description": "Error message if TypeSpec compilation failed (npm missing, compilation error, etc.). Null or absent when compilation succeeded or was not attempted."
        }
      }
    },
    "drivingAdapters": {
      "type": "object",
      "description": "Driving adapter generation status",
      "properties": {
        "http": {
          "type": "object",
          "description": "HTTP adapter (handlers, routes, DTOs)",
          "properties": {
            "status": {
              "type": "string",
              "enum": ["pending", "in_progress", "complete", "error"],
              "default": "pending"
            },
            "files": { "$ref": "#/$defs/fileList" }
          }
        }
      }
    },
    "contexts": {
      "type": "array",
      "description": "Bounded contexts to implement",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Bounded context name (lowercase, used for package naming)"
          },
          "contextId": {
            "type": "string",
            "description": "Context identifier (e.g., CTX-001)"
          },
          "fqbcFile": {
            "type": "string",
            "description": "Path to the FQBC file for this context"
          },
          "status": {
            "type": "string",
            "description": "Overall implementation status",
            "enum": ["pending", "in_progress", "complete", "error"]
          },
          "phases": {
            "type": "object",
            "description": "Per-phase implementation status",
            "properties": {
              "domain": { "$ref": "#/$defs/phaseStatus" },
              "ports": { "$ref": "#/$defs/phaseStatus" },
              "application": { "$ref": "#/$defs/phaseStatus" },
              "drivenAdapters": { "$ref": "#/$defs/phaseStatus" },
              "mock": { "$ref": "#/$defs/phaseStatus" }
            }
          },
          "generatedFiles": {
            "type": "object",
            "description": "File paths created for each phase",
            "properties": {
              "domain": { "$ref": "#/$defs/fileList" },
              "ports": { "$ref": "#/$defs/fileList" },
              "application": { "$ref": "#/$defs/fileList" },
              "drivenAdapters": { "$ref": "#/$defs/fileList" },
              "mock": { "$ref": "#/$defs/fileList" }
            }
          },
          "entities": {
            "type": "array",
            "description": "Entity names within this context",
            "items": { "type": "string" }
          },
          "valueObjects": {
            "type": "array",
            "description": "Value object names within this context",
            "items": { "type": "string" }
          },
          "domainEvents": {
            "type": "array",
            "description": "Domain event names published by this context",
            "items": { "type": "string" }
          },
          "integrations": {
            "type": "array",
            "description": "Integrations with other contexts",
            "items": {
              "type": "object",
              "required": ["targetContext", "type"],
              "properties": {
                "targetContext": {
                  "type": "string",
                  "description": "Name of the context being integrated with"
                },
                "type": {
                  "type": "string",
                  "description": "Integration type",
                  "enum": ["sync", "async"]
                },
                "direction": {
                  "type": "string",
                  "description": "Integration direction",
                  "enum": ["inbound", "outbound", "bidirectional"]
                },
                "status": {
                  "type": "string",
                  "enum": ["pending", "implemented"]
                },
                "adapterFiles": {
                  "type": "array",
                  "description": "File paths of generated ACL adapters or event handlers for this integration",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "errors": {
            "type": "array",
            "description": "Errors encountered during generation",
            "items": {
              "type": "object",
              "properties": {
                "phase": { "type": "string" },
                "file": { "type": "string" },
                "error": { "type": "string" },
                "timestamp": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "description": "Build and test validation status",
      "properties": {
        "build": {
          "type": "string",
          "enum": ["pending", "passing", "failing"],
          "default": "pending"
        },
        "tests": {
          "type": "string",
          "enum": ["pending", "passing", "failing"],
          "default": "pending"
        },
        "lastBuildOutput": {
          "type": ["string", "null"],
          "description": "Output from the last build attempt"
        }
      }
    },
    "history": {
      "type": "array",
      "description": "Session history for audit trail",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          },
          "phase": {
            "type": "string",
            "description": "Which manifest phase this action belongs to"
          },
          "context": {
            "type": "string"
          },
          "filesCreated": {
            "type": "integer"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "phaseStatus": {
      "type": "string",
      "enum": ["pending", "in_progress", "complete", "error"]
    },
    "fileList": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}
